{
  "manifest_version": 3,
  "name": "GT350 Hunter — Shelby Mustang Finder",
  "version": "1.0.0",
  "description": "Search multiple car marketplaces at once for a 2015–2020 Ford Mustang Shelby GT350 or GT350R.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "GT350 Hunter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "scripting", "contextMenus"],
  "host_permissions": [
    "https://www.autotrader.co.uk/*",
    "https://www.pistonheads.com/*",
    "https://www.ebay.co.uk/*",
    "https://www.cazoo.co.uk/*",
    "https://www.carandclassic.com/*",
    "https://www.autotrader.com/*",
    "https://www.cars.com/*",
    "https://www.cargurus.com/*",
    "https://bringatrailer.com/*",
    "https://www.autotrader.ca/*"
  ]
}
